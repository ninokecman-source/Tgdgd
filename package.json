{
  "name": "proprio-whatsapp-cliniko",
  "version": "1.0.0",
  "description": "WhatsApp podsjetnici za termine iz Clinikoa (Proprio Centar). Bez vanjskih ovisnosti.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "check": "node --disable-warning=ExperimentalWarning src/cli.js check",
    "preview": "node --disable-warning=ExperimentalWarning src/cli.js reminders --dry-run",
    "send": "node --disable-warning=ExperimentalWarning src/cli.js reminders",
    "status": "node --disable-warning=ExperimentalWarning src/cli.js status",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/*.test.js"
  }
}
