# =====================================================================
#  Proprio WhatsApp <-> Cliniko  –  postavke
#  Kopiraj ovu datoteku u ".env" i popuni vrijednosti.
#  .env NIKAD ne stavljaj u Dropbox, e-mail, chat ni git.
# =====================================================================

# ---------- Cliniko ----------
# Cliniko -> My Info -> Manage API keys -> Add an API key
# (preporuka: zaseban Cliniko korisnik samo za integraciju)
CLINIKO_API_KEY=
# Obavezno: naziv aplikacije i ISPRAVAN kontakt e-mail (Cliniko to traži)
CLINIKO_USER_AGENT=Proprio WhatsApp podsjetnici (info@proprio.hr)
# Uključiti i grupne termine (grupni programi)? true / false
CLINIKO_INCLUDE_GROUP=true
# Upisivati potvrdu pacijenta u napomenu termina u Clinikou? true / false
# (API ključ tada mora imati pravo uređivanja termina)
CLINIKO_WRITE_NOTES=false

# ---------- WhatsApp ----------
# "360dialog"  -> postojeći broj ostaje u aplikaciji na mobitelu (coexistence)
# "meta"       -> izravno Meta Cloud API (za coexistence potreban partner)
WA_PROVIDER=360dialog

# -- ako je WA_PROVIDER=360dialog
D360_API_KEY=

# -- ako je WA_PROVIDER=meta
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_GRAPH_VERSION=v23.0
# App Dashboard -> Settings -> Basic -> App secret (za provjeru potpisa webhooka)
WA_APP_SECRET=
# Proizvoljan dugi niz; isti upiši u Meta webhook postavke
WA_VERIFY_TOKEN=

# ---------- Predložak poruke ----------
# Mora biti ODOBREN kod Mete; tijelo: {{1}} ime, {{2}} datum, {{3}} sat
WA_TEMPLATE_NAME=podsjetnik_termin
WA_TEMPLATE_LANG=hr
# Tekst gumba iz predloška (koristi se za prepoznavanje odgovora)
WA_BUTTON_CONFIRM=Potvrđujem
WA_BUTTON_CHANGE=Trebam promjenu
# Automatski odgovor nakon klika na gumb (prazno = bez odgovora)
WA_REPLY_CONFIRM=Hvala! Vidimo se u Proprio Centru.
WA_REPLY_CHANGE=Hvala, javit ćemo Vam se uskoro radi novog termina.

# ---------- Privola pacijenata ----------
# custom_field -> Cliniko prilagođeno polje pacijenta (preporuka za rad)
# allowlist    -> samo pacijenti/brojevi iz datoteke CONSENT_FILE (pilot)
# all          -> svi pacijenti s mobitelom (NE preporučuje se)
CONSENT_MODE=allowlist
CONSENT_FIELD_NAME=WhatsApp podsjetnici
CONSENT_FILE=./consent.txt

# ---------- Raspored ----------
TIMEZONE=Europe/Zagreb
# Za koliko dana unaprijed se šalje podsjetnik (1 = sutrašnji termini)
REMINDER_DAYS_AHEAD=1
# U kojim satima (lokalno vrijeme) se pokreće slanje. Zadano: svaki sat 10–19 h,
# tako da i termini upisani tijekom dana dobiju podsjetnik. Duplikata nema.
# Primjeri: 10-19   ili   10,14,18
REMINDER_HOURS=10-19

# ---------- Server ----------
PORT=3000
# Putanja webhooka. Za 360dialog stavi dug nasumičan dio, npr.
# /whatsapp/webhook/3f9c1e7a2b...
WEBHOOK_PATH=/whatsapp/webhook
# Token za statusnu stranicu recepcije: https://.../status?token=...
STATUS_TOKEN=
# Baza (SQLite datoteka)
DB_PATH=./data/proprio-whatsapp.db
# Koliko dana čuvati zapise (GDPR)
RETENTION_DAYS=90

# ---------- Testiranje ----------
# true = ništa se ne šalje, samo ispis što bi se poslalo
DRY_RUN=false
# Ako je upisan, SVE poruke idu na ovaj broj umjesto pacijentima.
# Oprez: ti se podsjetnici bilježe kao poslani – pravi pacijenti ih taj dan više ne dobivaju.
# Za prvi test bolje: testni pacijent u Clinikou + allowlist (vidi README, poglavlje 6).
TEST_PHONE=
