# Kopiraj u .env i popuni. .env NIKAD ne ide u git (već je u .gitignore).
# Token i App Secret nikad ne šalji e-mailom ni u chatu (G-86).

# --- WhatsApp Cloud API (korak 2-5 uputa) -----------------------------
# Trajni System User token (korak 4), NE privremeni 24-satni s API Setup stranice.
WA_TOKEN=
# WhatsApp -> API Setup -> "Phone number ID" (za /messages i /register)
WA_PHONE_NUMBER_ID=
# WhatsApp -> API Setup -> "WhatsApp Business Account ID" (za /subscribed_apps i predloške)
WA_WABA_ID=
# App Dashboard -> Settings -> Basic -> App Secret (za provjeru potpisa webhooka)
WA_APP_SECRET=
# Dugi nasumični niz koji sam izmisliš; isti upišeš u App Dashboard -> WhatsApp -> Configuration -> Webhook.
# Npr.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WA_VERIFY_TOKEN=
# Najnovija stabilna verzija Graph API-ja (developers.facebook.com/docs/graph-api/changelog)
WA_GRAPH_VERSION=v23.0

# --- Predložak podsjetnika (korak 6) -----------------------------------
WA_TEMPLATE_REMINDER=podsjetnik_termin
WA_TEMPLATE_LANGUAGE=hr
# Tekst gumba – mora biti isti kao u predlošku
WA_BUTTON_CONFIRM=Potvrđujem
WA_BUTTON_CHANGE=Trebam promjenu
# Što ide u {{1}} ako pacijent u Clinikou nema ime (G-44)
WA_NAME_FALLBACK=gospođo/gospodine

# --- Automatski odgovori (šalju se samo odmah nakon pacijentove poruke) ---
REPLY_CONFIRMED=Hvala, Vaš dolazak je potvrđen. Vidimo se!
REPLY_CHANGE=Hvala na javljanju. Recepcija će Vas nazvati radi dogovora novog termina.
REPLY_STOP=Odjavljeni ste s WhatsApp obavijesti Proprio Centra. Više Vam nećemo slati poruke ovim putem.
# Riječi kojima se pacijent odjavljuje (odvojene zarezom)
STOP_WORDS=STOP,ODJAVA,ODJAVI

# --- Cliniko (izvor termina, samo čitanje) -----------------------------
# Cliniko -> My info -> Manage API keys. Daje pristup podacima pacijenata – čuvaj kao lozinku.
CLINIKO_API_KEY=
# Cliniko traži naziv aplikacije i kontakt mail u svakom zahtjevu
CLINIKO_USER_AGENT=Proprio WhatsApp podsjetnici (tvoj_mail@primjer.hr)
# Ako u Clinikou ima više poslovnica, a podsjetnici idu samo za jednu (ID iz URL-a poslovnice)
CLINIKO_BUSINESS_ID=

# --- Podsjetnici --------------------------------------------------------
TIMEZONE=Europe/Zagreb
# Podsjetnik ide kad je do termina ovoliko sati ili manje...
REMINDER_HOURS_BEFORE=24
# ...ali ne ako je do termina manje od ovoga
REMINDER_MIN_HOURS_BEFORE=2
# Lokalni sati u kojima se smije slati (od-do)
SEND_HOURS=8-20
# Koliko prolaza pokušati kod privremene greške prije predaje recepciji
MAX_SEND_ATTEMPTS=3
# Ako podsjetnik nije isporučen ovoliko sati prije termina -> zadatak recepciji (G-51)
UNDELIVERED_ALERT_HOURS=4
# Rok čuvanja poruka i podsjetnika u danima (poglavlje 5)
RETENTION_DAYS=365

# --- Server -------------------------------------------------------------
PORT=3000
# 127.0.0.1 = dostupno samo preko reverse proxyja (Caddy/nginx) s HTTPS-om
HOST=127.0.0.1
DB_PATH=data/whatsapp.sqlite3
# Javni HTTPS URL webhooka – samo za "npm run alat -- provjera"
WEBHOOK_PUBLIC_URL=https://api.proprio.hr/whatsapp/webhook

# --- Stranica za recepciju (/recepcija) --------------------------------
# Ako je prazno, stranica je isključena. Lozinka neka bude duga.
RECEPTION_USER=recepcija
RECEPTION_PASSWORD=

# --- Nadzor (/zdravlje) -------------------------------------------------
# 503 ako se posao podsjetnika nije pokrenuo ovoliko minuta (cron svakih 15 min)
HEALTH_MAX_JOB_AGE_MINUTES=60
# 503 ako poslana poruka ovoliko minuta nema nijedan status s webhooka
HEALTH_MAX_UNCONFIRMED_MINUTES=30
