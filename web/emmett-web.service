# Web pregled Emmett sustava. Kopiraj u /etc/systemd/system/ i pokreni:
#
#   sudo cp ~emmett/Tgdgd/web/emmett-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now emmett-web
#
# Sluša samo na 127.0.0.1. Prema van ide isključivo kroz Tailscale Serve
# (port 8443), koji drži HTTPS - stranica tako nikad nije na internetu.

[Unit]
Description=Emmett web pregled
After=network-online.target
Wants=network-online.target

[Service]
User=emmett
Group=emmett
WorkingDirectory=/home/emmett/Tgdgd
ExecStart=/home/emmett/venv/bin/gunicorn \
    --chdir /home/emmett/Tgdgd/web \
    --bind 127.0.0.1:8099 \
    --workers 2 \
    --timeout 30 \
    --no-control-socket \
    --access-logfile - \
    app:app
Restart=on-failure
RestartSec=5

# --no-control-socket: gunicorn od izdanja 25.1 otvara upravljačku utičnicu u
# $HOME/.gunicorn, a dom je ovdje samo za čitanje, pa bi pri svakom pokretanju
# bacio [ERROR] u log. Tu utičnicu (alat gunicornc) ne koristimo, pa je gasimo
# umjesto da zbog nje popustimo zaštitu.

# Aplikacija samo čita - nema razloga da smije bilo što više od toga.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
